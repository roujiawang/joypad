{
  "Computer": {
    "type": "device",
    "children": {
      "Settings": {
        "type": "section",
        "children": {
          "Network & Internet": {
            "type": "section",
            "children": {
              "Wi-Fi": {
                "type": "toggle",
                "state": "on",
                "actions": ["toggle"]
              },
              "VPN": {
                "type": "toggle",
                "state": "off",
                "actions": ["toggle"]
              }
            }
          },
          "System": {
            "type": "section",
            "children": {
              "Display": {
                "type": "section",
                "children": {
                  "Brightness": {
                    "type": "slider",
                    "value": 70,
                    "actions": ["set_value"]
                  },
                  "Night Light": {
                    "type": "toggle",
                    "state": "off",
                    "actions": ["toggle"]
                  }
                }
              },
              "Sound": {
                "type": "section",
                "children": {
                  "Volume": {
                    "type": "slider",
                    "value": 40,
                    "actions": ["set_value"]
                  },
                  "Mute": {
                    "type": "toggle",
                    "state": "off",
                    "actions": ["toggle"]
                  }
                }
              }
            }
          }
        }
      },
      "Apps": {
        "type": "section",
        "children": {
          "Microsoft Edge": {
            "type": "app",
            "path": "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe",
            "actions": ["open_app"]
          },
          "Notepad": {
            "type": "app",
            "path": "C:\\Windows\\System32\\notepad.exe",
            "actions": ["open_app"]
          }
        }
      },
      "FileExplorer": {
        "type": "section",
        "children": {
          "C: Drive": {
            "type": "drive",
            "path": "C:\\",
            "actions": ["open_folder"]
          },
          "Downloads": {
            "type": "folder",
            "path": "C:\\Users\\User\\Downloads",
            "actions": ["open_folder"]
          }
        }
      },
      "Desktop": {
        "type": "section",
        "children": {
          "Recycle Bin": {
            "type": "shortcut",
            "actions": ["open_app"]
          },
          "My Computer": {
            "type": "shortcut",
            "actions": ["open_app"]
          }
        }
      }
    }
  }
}
